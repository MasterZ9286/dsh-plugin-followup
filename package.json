{
  "name": "dsh-plugin-followup",
  "type": "module",
  "version": "1.0.0",
  "description": "划词追问：在助手回答里选中文字后右键追问，问答全部留在右侧面板，并从主对话中隐藏。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "dsh-plugin",
    "deepseek-harness",
    "follow-up",
    "selection",
    "right-panel"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "README.md",
    "cordis.patch.yml",
    "dist",
    "docs"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
